------------------------------
-- Measure: [# Order Quantity]
------------------------------
MEASURE 'Orders'[# Order Quantity] = SUM('Orders'[Net Order Quantity])
    , DisplayFolder = "_Order Measures"
    , FormatString = "#,##0"

-----------------------------------
-- Measure: [£ Average Order Value]
-----------------------------------
MEASURE 'Orders'[£ Average Order Value] = DIVIDE([£ Order Value], [# Order Quantity])
    , DisplayFolder = "_Order Measures"
    , FormatString = """$""#,##0"

---------------------------
-- Measure: [£ Order Value]
---------------------------
MEASURE 'Orders'[£ Order Value] = SUM('Orders'[Net Order Value])
    , DisplayFolder = "_Order Measures"
    , FormatString = """$""#,##0"

-----------------------------
-- Measure: [Product Sales %]
-----------------------------
MEASURE 'Orders'[Product Sales %] = 
    DIVIDE(
        [£ Order Value],
        CALCULATE(
            [£ Order Value],
            REMOVEFILTERS('Products'[Product Name])
        )
    )
    , DisplayFolder = "_Order Measures"
    , FormatString = "0.0%"

--------------------------------
-- Measure: [Product Sales Rank]
--------------------------------
MEASURE 'Orders'[Product Sales Rank] = 
    RANKX(
        ALL('Products'[Product Name]),
        [£ Order Value],
        ,
        DESC,
        DENSE
    )
    , DisplayFolder = "_Order Measures"
    , FormatString = "#,0"
