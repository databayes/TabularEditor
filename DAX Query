
MEASURE 'Orders'[£ Average Order Value] =
    DIVIDE([£ Order Value], [# Order Quantity])
    FormatString = "$#,0.00;($#,0.00);$#,0.00"

MEASURE 'Orders'[Product Sales %] =
    DIVIDE(
        [£ Order Value],
        CALCULATE(
            [£ Order Value],
            REMOVEFILTERS('Products'[Product Name])
        )
    )
    FormatString = "0.0%"

MEASURE 'Orders'[Product Sales Rank] =
    RANKX(
        ALL('Products'[Product Name]),
        [£ Order Value],
        ,
        DESC,
        DENSE
    )
    FormatString = "#,0"
